#!/bin/sh
#
# Stop and disable the daemons before the unit files disappear on remove.
#
set -e

case "$1" in
	remove)
		if [ -d /run/systemd/system ]; then
			systemctl --system stop dstargateway.service dgwtimeserver.service >/dev/null 2>&1 || true
			systemctl --system disable dstargateway.service dgwtimeserver.service >/dev/null 2>&1 || true
			systemctl --system stop dstargateway-hostfiles.timer >/dev/null 2>&1 || true
			systemctl --system disable dstargateway-hostfiles.timer >/dev/null 2>&1 || true
		fi
		;;

	upgrade | deconfigure | failed-upgrade)
		;;

	*)
		echo "$0 called with unknown argument '$1'" >&2
		exit 1
		;;
esac

exit 0
